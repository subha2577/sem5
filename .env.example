PROJECT_NAME="RecoverAI"
VERSION="1.0.0"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./recoverai.db"
TREND_SHORT_WINDOW=3
TREND_MEDIUM_WINDOW=7
BASELINE_STABLE_WINDOW=5
ALERT_EPISODE_WINDOW_HOURS=24
PERSISTENCE_MIN_READINGS=2
TASK_DUE_HOURS_HIGH=2
TASK_DUE_HOURS_REVIEW=6
ALERT_REDUCTION_TARGET_PCT=30.0
